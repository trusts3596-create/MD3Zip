{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .qoder/hooks/block-dangerous.sh",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .qoder/hooks/protect-paths.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
