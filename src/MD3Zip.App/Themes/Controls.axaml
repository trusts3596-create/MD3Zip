<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>
    <!-- MD3 滑块的两个轨道按钮与手柄外观 -->
    <ControlTheme x:Key="Md3.SliderTrackTheme" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" CornerRadius="3" />
        </ControlTemplate>
      </Setter>
    </ControlTheme>

    <ControlTheme x:Key="Md3.SliderThumbTheme" TargetType="Thumb">
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" CornerRadius="2" />
        </ControlTemplate>
      </Setter>
    </ControlTheme>
  </Styles.Resources>

  <!-- ============ 字体与排版 ============ -->

  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{DynamicResource Md3.FontFamily}" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="Foreground" Value="{DynamicResource Md3.OnSurface}" />
  </Style>

  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Md3.OnSurface}" />
  </Style>

  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Md3.OnSurface}" />
  </Style>

  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Md3.OnSurface}" />
  </Style>

  <Style Selector="TextBlock.body">
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="Foreground" Value="{DynamicResource Md3.OnSurface}" />
  </Style>

  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Md3.OnSurfaceVariant}" />
  </Style>

  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource Md3.OnSurfaceVariant}" />
  </Style>

  <!-- ============ Button 基类（MD3 状态层） ============ -->

  <Style Selector="Button">
    <Setter Property="FontFamily" Value="{DynamicResource Md3.FontFamily}" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Md3.Primary}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="18,10" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <Panel>
            <Border Name="PART_StateLayer"
                    Background="{DynamicResource Md3.StateHover}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Opacity="0" />
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="Button:pointerover /template/ Border#PART_StateLayer">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="Button:pressed /template/ Border#PART_StateLayer">
    <Setter Property="Background" Value="{DynamicResource Md3.StatePressed}" />
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="Button:disabled">
    <Setter Property="Opacity" Value="0.38" />
  </Style>

  <Style Selector="Button.filled">
    <Setter Property="Background" Value="{DynamicResource Md3.Primary}" />
    <Setter Property="Foreground" Value="{DynamicResource Md3.OnPrimary}" />
  </Style>

  <Style Selector="Button.tonal">
    <Setter Property="Background" Value="{DynamicResource Md3.SecondaryContainer}" />
    <Setter Property="Foreground" Value="{DynamicResource Md3.OnSecondaryContainer}" />
  </Style>

  <Style Selector="Button.outlined">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Md3.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Md3.Outline}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Button.text">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Md3.Primary}" />
  </Style>

  <Style Selector="Button.text.pill">
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="CornerRadius" Value="16" />
  </Style>

  <Style Selector="Button.text.pill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Md3.SecondaryContainer}" />
  </Style>

  <Style Selector="Button.text.pill:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Md3.SecondaryContainer}" />
  </Style>

  <Style Selector="Button.icon">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.crumb">
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource Md3.OnSurfaceVariant}" />
  </Style>

  <Style Selector="Button.crumb.current">
    <Setter Property="Foreground" Value="{DynamicResource Md3.OnSurface}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.segment">
    <Setter Property="Padding" Value="16,7" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Md3.OnSurfaceVariant}" />
  </Style>

  <!-- Extended FAB -->
  <Style Selector="Button.fab">
    <Setter Property="Height" Value="56" />
    <Setter Property="Padding" Value="22,0" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Background" Value="{DynamicResource Md3.PrimaryContainer}" />
    <Setter Property="Foreground" Value="{DynamicResource Md3.OnPrimaryContainer}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}"
                BoxShadow="0 4 14 0 #33000000">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Path Data="{DynamicResource Icon.Add}"
                  Fill="{TemplateBinding Foreground}"
                  Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" />
            <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <!-- ============ 窗口控制按钮（46x32 固定容器 + 10x10 描边图标） ============ -->

  <Style Selector="Button.caption">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_CaptionBg"
                Background="{TemplateBinding Background}"
                CornerRadius="8"
                Margin="2">
          <Border.Transitions>
            <Transitions>
              <BrushTransition Property="Background" Duration="0:0:0.14" />
            </Transitions>
          </Border.Transitions>
          <ContentPresenter Content="{TemplateBinding Content}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="Button.caption Path">
    <Setter Property="Stroke" Value="{DynamicResource Md3.OnSurfaceVariant}" />
    <Setter Property="StrokeThickness" Value="1.2" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="10" />
    <Setter Property="Stretch" Value="None" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.caption:pointerover /template/ Border#PART_CaptionBg">
    <Setter Property="Background" Value="{DynamicResource Md3.SurfaceVariant}" />
  </Style>

  <Style Selector="Button.caption:pressed /template/ Border#PART_CaptionBg">
    <Setter Property="Background" Value="{DynamicResource Md3.SurfaceContainerHighest}" />
  </Style>

  <Style Selector="Button.caption:pointerover Path">
    <Setter Property="Stroke" Value="{DynamicResource Md3.OnSurface}" />
  </Style>

  <Style Selector="Button.caption.close:pointerover /template/ Border#PART_CaptionBg">
    <Setter Property="Background" Value="{DynamicResource Md3.CloseHover}" />
  </Style>

  <Style Selector="Button.caption.close:pressed /template/ Border#PART_CaptionBg">
    <Setter Property="Background" Value="{DynamicResource Md3.CloseHover}" />
  </Style>

  <Style Selector="Button.caption.close:pointerover Path">
    <Setter Property="Stroke" Value="{DynamicResource Md3.CloseHoverIcon}" />
  </Style>

  <!-- ============ TextBox ============ -->

  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource Md3.SurfaceContainerHighest}" />
    <Setter Property="Foreground" Value="{DynamicResource Md3.OnSurface}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Md3.Primary}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Md3.PrimaryContainer}" />
    <Setter Property="SelectionForegroundBrush" Value="{DynamicResource Md3.OnPrimaryContainer}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <DataValidationErrors>
          <Border Name="PART_BorderElement"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <DockPanel Margin="{TemplateBinding Padding}">
              <ScrollViewer Name="PART_ScrollViewer"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Hidden"
                            VerticalAlignment="Center">
                <Panel>
                  <TextBlock Name="PART_Watermark"
                             Text="{TemplateBinding Watermark}"
                             Foreground="{DynamicResource Md3.OnSurfaceVariant}"
                             VerticalAlignment="Center"
                             IsHitTestVisible="False"
                             IsVisible="{TemplateBinding Text, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                  <TextPresenter Name="PART_TextPresenter"
                                 Text="{TemplateBinding Text, Mode=TwoWay}"
                                 CaretIndex="{TemplateBinding CaretIndex}"
                                 SelectionStart="{TemplateBinding SelectionStart}"
                                 SelectionEnd="{TemplateBinding SelectionEnd}"
                                 PasswordChar="{TemplateBinding PasswordChar}"
                                 RevealPassword="{TemplateBinding RevealPassword}"
                                 SelectionBrush="{TemplateBinding SelectionBrush}"
                                 SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                                 CaretBrush="{TemplateBinding CaretBrush}"
                                 TextAlignment="{TemplateBinding TextAlignment}"
                                 TextWrapping="{TemplateBinding TextWrapping}"
                                 VerticalAlignment="Center" />
                </Panel>
              </ScrollViewer>
            </DockPanel>
          </Border>
        </DataValidationErrors>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource Md3.OutlineSoft}" />
  </Style>

  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource Md3.Primary}" />
    <Setter Property="BorderThickness" Value="1.6" />
  </Style>

  <Style Selector="TextBox.search">
    <Setter Property="CornerRadius" Value="24" />
    <Setter Property="Padding" Value="8,10" />
    <Setter Property="MinHeight" Value="42" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- ============ CheckBox ============ -->

  <Style Selector="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource Md3.OnSurface}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Border Name="PART_Box"
                  Width="18" Height="18"
                  CornerRadius="5"
                  BorderThickness="1.6"
                  BorderBrush="{DynamicResource Md3.Outline}"
                  Background="Transparent"
                  VerticalAlignment="Center">
            <Path Name="PART_Check"
                  Data="{DynamicResource Icon.Check}"
                  Fill="{DynamicResource Md3.OnPrimary}"
                  Width="12" Height="12"
                  Stretch="Uniform"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  IsVisible="False" />
          </Border>
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            VerticalAlignment="Center" />
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="CheckBox:pointerover /template/ Border#PART_Box">
    <Setter Property="BorderBrush" Value="{DynamicResource Md3.Primary}" />
  </Style>

  <Style Selector="CheckBox:checked /template/ Border#PART_Box">
    <Setter Property="Background" Value="{DynamicResource Md3.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Md3.Primary}" />
  </Style>

  <Style Selector="CheckBox:checked /template/ Path#PART_Check">
    <Setter Property="IsVisible" Value="True" />
  </Style>

  <!-- ============ RadioButton（MD3 分段按钮） ============ -->

  <Style Selector="RadioButton.segment">
    <Setter Property="Foreground" Value="{DynamicResource Md3.OnSurfaceVariant}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="18,8" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                CornerRadius="14"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="RadioButton.segment:checked">
    <Setter Property="Background" Value="{DynamicResource Md3.SecondaryContainer}" />
    <Setter Property="Foreground" Value="{DynamicResource Md3.OnSecondaryContainer}" />
  </Style>

  <Style Selector="RadioButton.segment:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource Md3.OnSurface}" />
  </Style>

  <!-- ============ ProgressBar（Linear Progress Indicator） ============ -->

  <Style Selector="ProgressBar">
    <Setter Property="Background" Value="{DynamicResource Md3.SurfaceContainerHighest}" />
    <Setter Property="Foreground" Value="{DynamicResource Md3.Primary}" />
    <Setter Property="Height" Value="6" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid Height="{TemplateBinding Height}" ClipToBounds="True">
          <Border Name="PART_Track"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}" />
          <Border Name="PART_Indicator"
                  Background="{TemplateBinding Foreground}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  HorizontalAlignment="Left" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>

  <!-- 不确定进度：固定宽度 + 呼吸动画，避免伪造百分比 -->
  <Style Selector="ProgressBar:indeterminate /template/ Border#PART_Indicator">
    <Setter Property="Width" Value="120" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Style.Animations>
      <Animation Duration="0:0:1.4" IterationCount="INFINITE" Easing="SineEaseInOut">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0.3" />
        </KeyFrame>
        <KeyFrame Cue="50%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="0.3" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- ============ 容器 ============ -->

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource Md3.SurfaceContainerLow}" />
    <Setter Property="CornerRadius" Value="24" />
    <Setter Property="BoxShadow" Value="0 2 12 0 #1F000000" />
  </Style>

  <Style Selector="Border.surface">
    <Setter Property="Background" Value="{DynamicResource Md3.SurfaceContainerLowest}" />
    <Setter Property="CornerRadius" Value="16" />
  </Style>

  <Style Selector="Border.row">
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="10,8" />
  </Style>

  <Style Selector="Border.row:pointerover">
    <Setter Property="Background" Value="{DynamicResource Md3.SurfaceContainerHighest}" />
  </Style>

  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Md3.OutlineVariant}" />
    <Setter Property="Opacity" Value="0.6" />
  </Style>

  <!-- ============ Slider（MD3：细轨 + 竖条手柄） ============ -->

  <Style Selector="Slider">
    <Setter Property="Height" Value="36" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid VerticalAlignment="Center">
          <Track Name="PART_Track"
                 Minimum="{TemplateBinding Minimum}"
                 Maximum="{TemplateBinding Maximum}"
                 Value="{TemplateBinding Value}"
                 Orientation="Horizontal"
                 VerticalAlignment="Center">
            <Track.DecreaseButton>
              <RepeatButton Name="PART_DecreaseButton"
                            Theme="{StaticResource Md3.SliderTrackTheme}"
                            Height="6"
                            Background="{DynamicResource Md3.Primary}" />
            </Track.DecreaseButton>
            <Track.IncreaseButton>
              <RepeatButton Name="PART_IncreaseButton"
                            Theme="{StaticResource Md3.SliderTrackTheme}"
                            Height="6"
                            Background="{DynamicResource Md3.SurfaceContainerHighest}" />
            </Track.IncreaseButton>
            <Thumb Name="PART_Thumb"
                   Theme="{StaticResource Md3.SliderThumbTheme}"
                   Width="4" Height="32"
                   Background="{DynamicResource Md3.Primary}" />
          </Track>
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>

  <!-- 「更多」浮层里的菜单行 -->
  <Style Selector="Button.menuItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Md3.OverlayForeground}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>

  <Style Selector="Button.menuItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Md3.OverlayHover}" />
  </Style>

  <Style Selector="Button.menuItem:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

</Styles>
