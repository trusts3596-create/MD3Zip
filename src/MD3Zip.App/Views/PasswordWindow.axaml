<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MD3Zip.App.Localization"
        x:Class="MD3Zip.App.Views.PasswordWindow"
        Title="{loc:T 需要密码}"
        Width="472" Height="296"
        CanResize="False"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowStartupLocation="CenterOwner">

  <Border Background="{DynamicResource Md3.SurfaceContainerHigh}" CornerRadius="28"
          BoxShadow="0 18 48 0 #66000000">
    <Grid RowDefinitions="Auto,*,Auto" Margin="24,16,16,20">

      <!-- 标题栏 -->
      <Grid Grid.Row="0" Height="40" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"
            Background="Transparent" PointerPressed="OnHeaderPressed">
        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="12"
                Background="{DynamicResource Md3.SecondaryContainer}" VerticalAlignment="Center">
          <Path Data="{DynamicResource Icon.Lock}" Fill="{DynamicResource Md3.OnSecondaryContainer}"
                Width="18" Height="18" Stretch="Uniform"
                HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Grid.Column="1" Text="{loc:T 输入压缩包密码}" Classes="title" VerticalAlignment="Center" />
        <Button Grid.Column="2" Classes="caption close" VerticalAlignment="Center"
                Click="OnCancelClick" ToolTip.Tip="{loc:T 关闭}">
          <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" />
        </Button>
      </Grid>

      <!-- 提示 + 输入 -->
      <StackPanel Grid.Row="1" Spacing="12" Margin="0,6,8,0" VerticalAlignment="Top">
        <TextBlock Name="PromptText" Classes="caption" TextWrapping="Wrap" />

        <Grid>
          <TextBox Name="PasswordBox" PasswordChar="●" Watermark="{loc:T 压缩包密码}" Padding="14,10,46,10" />
          <Button Name="RevealButton" Classes="icon" Width="34" Height="34" CornerRadius="17"
                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"
                  Click="OnRevealClick" ToolTip.Tip="{loc:T 显示 / 隐藏密码}">
            <Path Name="RevealGlyph" Data="{DynamicResource Icon.Eye}"
                  Fill="{DynamicResource Md3.OnSurfaceVariant}"
                  Width="17" Height="17" Stretch="Uniform" />
          </Button>
        </Grid>

        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="False" Name="ErrorPanel">
          <Path Data="{DynamicResource Icon.Warning}" Fill="{DynamicResource Md3.Error}"
                Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
          <TextBlock Name="ErrorText" FontSize="12" Foreground="{DynamicResource Md3.Error}"
                     TextWrapping="Wrap" VerticalAlignment="Center" />
        </StackPanel>

        <ProgressBar Name="ValidationBar" IsIndeterminate="True" IsVisible="False" Height="4" />
      </StackPanel>

      <!-- 操作 -->
      <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right"
                  Margin="0,0,8,0">
        <Button Classes="text" Content="{loc:T 取消}" Click="OnCancelClick" IsCancel="True" />
        <Button Name="ConfirmButton" Classes="filled" Content="{loc:T 确认}" Click="OnConfirmClick" IsDefault="True" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
